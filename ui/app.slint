import { Button, LineEdit, VerticalBox, HorizontalBox, CheckBox, ScrollView, ComboBox, SpinBox, TextEdit, ProgressIndicator } from "std-widgets.slint";
export struct TaskRow { id:int, package:string, status:string, active:bool, cancellable:bool, completed:bool, damaged:bool, cleaning:bool }
export component AppWindow inherits Window {
    title: "TraceFox"; icon: @image-url("../assets/branding/tracefox-app.png"); preferred-width:560px;preferred-height:460px;min-width:520px;min-height:420px;
    in-out property <string> directory;
    in-out property <bool> watching;
    in property <string> monitor-status;
    in property <string> queue-text;
    in property <bool> can-cleanup;
    in property <bool> cleaning;
    in property <[TaskRow]> tasks;
    callback choose-directory();callback toggle-watch();callback import-package();callback edit-rules();
    callback cancel(int);callback retry(int);callback details(int);callback delete-damaged(int);callback open-report(int);callback open-folder(int);callback cleanup-report(int);callback cleanup-completed();
    // 监控配置归为一组；任务进度及操作只出现在对应行，避免全局状态串到其他诊断包。
    VerticalBox {padding:14px;spacing:8px;
        HorizontalBox {padding:0;spacing:6px;vertical-stretch:0;height:32px;
            Button {enabled:!root.cleaning;text:root.watching ? "暂停监控" : "开启监控";primary:root.watching;accessible-checkable:true;accessible-checked:root.watching;clicked=>{root.watching=!root.watching;root.toggle-watch();}}
            LineEdit {read-only:true;text:root.directory;placeholder-text:"选择下载目录";horizontal-stretch:1;}
            Button {enabled:!root.cleaning;text:"选择";clicked=>{root.choose-directory();}}
        }
        HorizontalBox {padding:0;spacing:6px;vertical-stretch:0;height:28px;
            Text {text:root.monitor-status;color:#687386;font-size:12px;overflow:elide;vertical-alignment:center;horizontal-stretch:1;}
            Button {text:root.cleaning ? "正在清理…" : "清理已完成";enabled:root.can-cleanup;clicked=>{root.cleanup-completed();}}
        }
        HorizontalBox {padding:0;spacing:6px;alignment:start;vertical-stretch:0;height:32px;
            Button {text:"导入诊断包";primary:true;clicked=>{root.import-package();}}
            Button {text:"关键词与报告规则";clicked=>{root.edit-rules();}}
        }
        Rectangle {vertical-stretch:1;min-height:140px;background:#f1f4f8;border-radius:8px;
            VerticalBox {padding:8px;spacing:6px;
                HorizontalBox {padding:0;vertical-stretch:0;
                    Text {text:"分析列表";font-size:14px;font-weight:600;}
                    Text {text:root.queue-text;color:#687386;font-size:12px;horizontal-alignment:right;}
                }
                if root.tasks.length==0: Rectangle {vertical-stretch:1;Text{text:"导入诊断包，或开启目录监控";color:#687386;font-size:12px;horizontal-alignment:center;vertical-alignment:center;}}
                if root.tasks.length>0: task-scroll := ScrollView {vertical-stretch:1;viewport-height:max(self.visible-height,task-items.min-height);
                    task-items := VerticalBox {x:0px;y:0px;width:task-scroll.visible-width;height:self.min-height;padding:0;spacing:6px;alignment:start;
                        for task in root.tasks: Rectangle {height:48px;vertical-stretch:0;background:#fff;border-radius:6px;
                            HorizontalBox {padding:6px;spacing:6px;
                                VerticalBox {padding:0;spacing:2px;horizontal-stretch:1;
                                    Text {text:task.package;overflow:elide;vertical-stretch:0;}
                                    Text {text:task.cleaning ? "正在清理…" : task.status;overflow:elide;color:#687386;font-size:12px;vertical-stretch:0;}
                                }
                                if task.completed: Button {height:32px;vertical-stretch:0;text:"打开 HTML";enabled:!task.cleaning;clicked=>{root.open-report(task.id);}}
                                if task.completed: Button {height:32px;vertical-stretch:0;text:"打开目录";enabled:!task.cleaning;clicked=>{root.open-folder(task.id);}}
                                if !task.completed && !task.damaged: Button {height:32px;vertical-stretch:0;text:"详情";clicked=>{root.details(task.id);}}
                                if task.active: Button {height:32px;vertical-stretch:0;text:task.cancellable ? "取消" : "取消中";enabled:task.cancellable;clicked=>{root.cancel(task.id);}}
                                if !task.active && !task.completed && !task.damaged: Button {height:32px;vertical-stretch:0;text:"重试";clicked=>{root.retry(task.id);}}
                                if task.damaged: Button {height:32px;vertical-stretch:0;text:"删除";clicked=>{root.delete-damaged(task.id);}}
                                if task.completed: Button {height:32px;width:32px;vertical-stretch:0;text:"···";accessible-label:"更多操作";enabled:!task.cleaning;clicked=>{menu.show();}}
                            }
                            menu := PopupWindow {x:parent.width - 150px;y:48px;width:150px;height:116px;
                                Rectangle {background:#fff;border-width:1px;border-color:#dce2ea;border-radius:6px;
                                    VerticalBox {padding:6px;spacing:4px;
                                        Button {text:"详情";clicked=>{menu.close();root.details(task.id);}}
                                        Button {text:"重新分析";clicked=>{menu.close();root.retry(task.id);}}
                                        Button {text:"清理";clicked=>{menu.close();root.cleanup-report(task.id);}}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Text {vertical-stretch:0;text:"关闭窗口进入托盘 · 文件由你自行管理";font-size:12px;color:#687386;}
    }
}
// 列表内容采用整行可点击区域，支持键盘和读屏，不把每条规则画成表单按钮。
component RuleEntry inherits Rectangle {
    in property <string> name;
    in property <string> summary;
    in property <string> display-name: name;
    in property <string> source;
    in property <bool> enabled: true;
    in property <bool> chosen;
    in property <int> focus-generation;
    callback clicked();
    accessible-role: button; accessible-label: name; accessible-enabled: enabled;
    accessible-action-default => {if root.enabled {root.clicked();}}
    changed focus-generation => {if root.chosen && root.enabled {key.focus();}}
    background: area.pressed ? #e1eafa : area.has-hover ? #f4f7fc : transparent;
    border-radius: 6px;
    border-width: key.has-focus ? 1px : 0px; border-color:#81a8e3;
    key := FocusScope {enabled:root.enabled;
        key-pressed(event)=>{if event.text==Key.Return || event.text==" " {root.clicked();return accept;}return reject;}
    }
    VerticalBox {padding:4px;padding-left:4px;spacing:3px;alignment:center;
        Text{text:root.display-name;font-size:15px;font-weight:600;horizontal-alignment:left;overflow:elide;vertical-stretch:0;}
        if root.summary!="":Text{text:root.summary;font-size:13px;color:#526172;overflow:elide;vertical-stretch:0;}
        if root.source!="":Text{text:"来源："+root.source;font-size:12px;color:#748092;overflow:elide;vertical-stretch:0;}
    }
    area := TouchArea {enabled:root.enabled;clicked=>{key.focus();root.clicked();}}
}
// 规则编辑器的统一尺寸：常规控件等宽，标签列和操作列独立占位。
global EditorMetrics {
    out property <length> control-width:320px;
    out property <length> control-height:32px;
    out property <length> label-width:84px;
    out property <length> field-gap:12px;
}
// 折叠标题保留按钮的键盘与辅助技术语义，文字固定靠左。
component Disclosure inherits Rectangle {
    in property <string> text;
    in property <bool> expanded;
    callback clicked();
    height:32px;vertical-stretch:0;
    accessible-role:button;accessible-label:text;
    accessible-action-default=>{root.clicked();}
    background:touch.pressed ? #e1eafa : touch.has-hover ? #f0f3f7 : transparent;
    border-radius:4px;
    border-width:keys.has-focus ? 1px : 0px;border-color:#81a8e3;
    keys := FocusScope {key-pressed(event)=>{if event.text==Key.Return || event.text==" " {root.clicked();return accept;}return reject;}}
    Path {x:2px;y:12px;width:8px;height:8px;stroke:#66758a;stroke-width:1.5px;commands:root.expanded ? "M 0 2 L 4 6 L 8 2" : "M 2 0 L 6 4 L 2 8";}
    Text {x:18px;width:parent.width - 18px;text:root.text;horizontal-alignment:left;vertical-alignment:center;font-weight:600;}
    touch := TouchArea {clicked=>{keys.focus();root.clicked();}}
}
// 常用表单行共享标签尺寸，输入区域始终从同一条垂直线开始。
component FormLabel inherits Text {
    width:EditorMetrics.label-width;horizontal-stretch:0;horizontal-alignment:left;vertical-alignment:center;color:#526172;
}
// 输入过程中保留本地文本；回车/离焦提交，Escape 原位恢复且不冒泡关闭抽屉。
component TermInput inherits FocusScope {
    in property <string> value;
    in property <string> hint: "匹配内容";
    callback commit(string);
    callback stage(string);
    property <bool> cancelled;
    changed value=>{input.text=root.value;root.cancelled=false;}
    height:32px; vertical-stretch:0;horizontal-stretch:1;
    forward-focus: input;
    key-pressed(event)=>{if event.text==Key.Escape {input.text=root.value;root.stage(root.value);root.cancelled=true;return accept;}return reject;}
    input := LineEdit {width:parent.width;height:parent.height;enabled:root.enabled;text:root.value;placeholder-text:root.hint;
        edited=>{root.cancelled=false;root.stage(self.text);}
        accepted=>{root.commit(self.text);}
        changed has-focus=>{if !self.has-focus && !root.cancelled && self.text!=root.value {root.commit(self.text);}}
    }
}
export struct FieldListRow { name: string, path: string, format: int }
export struct RuleListRow { expanded:bool, name: string, group: string, identity: string, summary: string, source: string, enabled: bool, offset: float, height: float, terms: [string] }

// 列表和弹窗共享窗口，背景禁用；弹窗副本由 Rust 管理，完成前不修改主草稿。
export component EditorWindow inherits Window {
    title: "TraceFox · 规则编辑"; icon: @image-url("../assets/branding/tracefox-app.png"); preferred-width: 1160px; preferred-height: 760px; min-width: 800px; min-height: 580px;
    background: #f5f6f8;
    property <length> field-width:min(EditorMetrics.control-width,(root.width<1000px ? root.width : 740px) - 172px);
    in-out property <int> section;
    in-out property <string> search;
    in-out property <string> webdav-url;
    in-out property <string> webdav-path;
    in-out property <string> webdav-user;
    in-out property <string> webdav-password;
    in property <bool> webdav-configured: false;
    in property <[RuleListRow]> rows;
    in property <[string]> file-names;
    in property <[string]> file-labels;
    in-out property <string> active-file;
    in property <int> file-index;
    callback select-file(int);
    callback toggle-rule(string);
    callback inline-term(string,int,string,bool);
    callback stage-term(string,int,string);
    callback inline-enabled(string,bool);
    callback edit-term(int,string);
    callback reference-rules();
    in-out property <int> selected: -1;
    in-out property <string> rule-name;
    in-out property <string> group-name;
    in-out property <bool> enabled-rule: true;
    in-out property <string> source;
    in-out property <int> source-mode;
    in-out property <string> terms;
    in property <[string]> term-tags;
    in-out property <string> new-term;
    callback add-term(); callback remove-term(int);
    in property <[string]> field-names;
    in property <[FieldListRow]> field-rows;
    callback edit-field(int, int, string);
    in property <[string]> sample-paths;
    in-out property <int> field-index: -1;
    in-out property <int> loaded-field: -1;
    in-out property <string> field-name;
    in-out property <string> field-path;
    in-out property <string> field-capture;
    in-out property <int> field-format;
    in-out property <int> field-view;
    in-out property <string> field-unit;
    in-out property <string> field-missing;
    in-out property <bool> field-wide;
    callback select-field(int); callback new-field(); callback delete-field(int); callback move-field(int);
    in-out property <string> excludes;
    in-out property <string> note;
    in-out property <int> match-mode;
    in-out property <bool> regex-mode;
    in-out property <bool> case-sensitive: true;
    in-out property <int> before: 10;
    in-out property <int> after: 10;
    in-out property <int> target;
    in-out property <bool> reverse;
    in-out property <bool> rule-open;
    in-out property <string> formatter;
    in-out property <string> time-pattern;
    in-out property <string> time-format;
    in-out property <string> timezone;
    in-out property <int> sort-mode;
    in-out property <int> extract-mode;
    in-out property <string> selector;
    in-out property <string> extract-pattern;
    in-out property <int> view-mode;
    in-out property <string> fields;
    in-out property <string> missing;
    in-out property <string> join-rule;
    in-out property <string> join-key;
    in-out property <string> foreign-key;
    in-out property <bool> advanced;
    in-out property <string> sample;
    in-out property <string> feedback;
    in-out property <string> title-text;
    in-out property <string> system-title;
    in-out property <string> keyword-title;
    in-out property <string> timeline-title;
    in-out property <string> accent;
    in-out property <int> font-size:14;
    in-out property <int> density;
    in-out property <int> section-order;
    in-out property <int> timeline-sort;
    in-out property <bool> first-open;
    in-out property <int> log-lines-per-batch:200;
    callback section-change();callback select-rule(int);callback add-rule();callback copy-rule();callback delete-rule();callback move-rule(int);callback apply-rule();callback save-all();callback cancel-edit();callback restore-defaults();callback import-rules();callback export-rules(bool);callback test-rule();callback load-sample();callback search-change(); callback webdav-upload(); callback webdav-download(); callback webdav-sync();

    in-out property <bool> dialog-open;
    in property <bool> reduced-motion;
    property <float> drawer-progress:root.dialog-open && !root.webdav-dialog-open ? 1 : 0;
    animate drawer-progress {duration:root.reduced-motion ? 0ms : 180ms;easing:ease-out;}
    // WebDAV 配置使用独立弹窗状态，避免与规则编辑草稿互相影响。
    in-out property <bool> webdav-dialog-open;
    in-out property <bool> webdav-testing;
    in-out property <int> webdav-generation;
    in-out property <string> webdav-feedback;
    callback focus-webdav(); callback focus-webdav-entry();
    focus-webdav => { webdav-address.focus(); }
    focus-webdav-entry => { webdav-entry.focus(); }
    callback open-webdav-dialog(); callback webdav-save(); callback webdav-test-dialog(); callback webdav-cancel();
    in-out property <bool> wizard;
    in-out property <int> step;
    in-out property <bool> dirty;
    in-out property <bool> match-options;
    in-out property <bool> field-options;
    in-out property <bool> show-errors;
    in-out property <bool> display-options;
    in-out property <bool> test-options;
    in property <[string]> group-choices;
    in property <float> content-height;
    in-out property <int> menu-row: -1;
    in-out property <bool> export-menu;
    in-out property <int> drag-from: -1;
    in-out property <bool> dragging;
    in-out property <string> drag-id;
    in-out property <length> drag-y;
    in-out property <length> drag-pointer-y;
    in-out property <length> grab-y;
    in-out property <int> drop-target: -1;
    in-out property <bool> drop-after;
    in property <float> drop-line-y;
    callback cancel-dialog(); callback next-step(); callback choose-row(int);
    callback drop-row(string, int, bool); callback drag-hover(float);
    callback focus-dialog(); callback focus-list();
    focus-dialog => { modal.focus(); }
    in-out property <int> focus-generation;
    focus-list => { list-focus.focus(); root.focus-generation += 1; }
    changed title-text => {if root.section==3 {root.dirty=true;}}
    changed system-title => {if root.section==3 {root.dirty=true;}}
    changed keyword-title => {if root.section==3 {root.dirty=true;}}
    changed timeline-title => {if root.section==3 {root.dirty=true;}}
    changed accent => {if root.section==3 {root.dirty=true;}}
    changed font-size => {if root.section==3 {root.dirty=true;}}
    changed density => {if root.section==3 {root.dirty=true;}}
    changed section-order => {if root.section==3 {root.dirty=true;}}
    changed timeline-sort => {if root.section==3 {root.dirty=true;}}
    changed first-open => {if root.section==3 {root.dirty=true;}}
    changed log-lines-per-batch => {if root.section==3 {root.dirty=true;}}
    forward-focus: list-focus;
    list-focus := FocusScope {
        width: parent.width; height: parent.height; enabled: !root.dialog-open;
        key-pressed(event) => {
            if event.text == Key.Escape { root.drag-from = -1; root.dragging = false; root.menu-row = -1; return accept; }
            return reject;
        }
        VerticalBox { x:0px;y:0px;width:parent.width;height:parent.height;padding:14px;spacing:8px;
            HorizontalBox { padding:0; height: 32px; vertical-stretch:0;
                for label[i] in ["关键词", "系统信息", "时间线", "报告样式"]: Button {enabled:!root.dialog-open;
                    text: label; primary: root.section == i;
                    clicked => { root.menu-row = -1; root.export-menu = false; root.section = i; root.section-change(); }
                }
            }
            if root.section != 3: HorizontalBox { padding:0; height: 32px; vertical-stretch:0;
                LineEdit {enabled:!root.dialog-open; text <=> root.search; placeholder-text: "搜索当前文件的规则…"; edited => {root.menu-row = -1; root.search-change();} }
                Button {enabled:!root.dialog-open; text: "＋"; accessible-label:"添加规则到此日志文件"; width:36px; horizontal-stretch:0; primary: true; clicked => {root.add-rule();} }
                if root.section == 1: Button {enabled:!root.dialog-open;text:"套用参考配置";clicked=>{root.reference-rules();}}
                Button {enabled:!root.dialog-open;text:"导入";clicked=>{root.import-rules();}}
                Button {enabled:!root.dialog-open;text:"导出 ▾";clicked=>{root.export-menu = !root.export-menu;}}
            }
            HorizontalBox { padding:0; height: 32px; vertical-stretch:0; alignment:start;
                webdav-entry := Button {enabled:!root.dialog-open;text:root.webdav-configured ? "编辑 WebDAV 服务器" : "＋ 添加 WebDAV 服务器";clicked=>{root.open-webdav-dialog();}}
                Button {enabled:!root.dialog-open && root.webdav-configured;text:"上传规则";clicked=>{root.webdav-upload();}}
                Button {enabled:!root.dialog-open && root.webdav-configured;text:"下载规则";clicked=>{root.webdav-download();}}
                Button {enabled:!root.dialog-open && root.webdav-configured;text:"双向同步";clicked=>{root.webdav-sync();}}
            }
            if root.export-menu: HorizontalBox { padding:0;height:32px; alignment:end;
                Button{enabled:!root.dialog-open;text:"导出全部";clicked=>{root.export-rules(false);root.export-menu=false;}}
                Button{text:"导出选中";enabled:!root.dialog-open && (root.selected>=0);clicked=>{root.export-rules(true);root.export-menu=false;}}
            }
            if root.search != "": Text {text:"搜索结果中暂停排序，清空搜索后可拖动。";color:#687386;vertical-stretch:0;}
            if root.section!=3: HorizontalBox {padding:0;spacing:12px;min-width:0px;
                if root.width>=1000px: Rectangle {width:188px;horizontal-stretch:0;background:#edf0f4;border-radius:10px;
                    VerticalBox {padding:10px;spacing:6px;
                        Text{text:"日志文件";font-weight:600;color:#526172;vertical-stretch:0;}
                        ScrollView {VerticalBox {padding:0;spacing:4px;alignment:start;
                            for file[i] in root.file-labels: Button {enabled:!root.dialog-open;text:file;primary:i==root.file-index;clicked=>{root.select-file(i);}}
                        }}
                    }
                }
                VerticalBox {padding:0;spacing:8px;
                    if root.width<1000px: ComboBox {enabled:!root.dialog-open;model:root.file-labels;current-index:root.file-index;selected(_)=>{root.select-file(self.current-index);}}
                    if root.width>=1000px: Text {text:root.active-file=="" ? "日志文件" : root.active-file;font-size:18px;font-weight:600;overflow:elide;vertical-stretch:0;}
                    Rectangle {background:#f5f6f8;clip:true;
                        list := ScrollView {
                            property <int> reveal-generation:root.focus-generation;
                            property <string> file:root.active-file;
                            changed file=>{self.viewport-y=0px;}
                            changed reveal-generation=>{if root.selected>=0 {
                                let row=root.rows[root.selected];
                                if row.offset*1px+self.viewport-y<0px {self.viewport-y=-row.offset*1px;}
                                if (row.offset+row.height)*1px+self.viewport-y>self.height {self.viewport-y=min(0px,self.height - (row.offset+row.height)*1px);}
                            }}
                            width:parent.width;height:parent.height;viewport-width:self.width;viewport-height:root.content-height*1px;
                            for row[i] in root.rows: Rectangle {
                                y:row.offset*1px;width:list.visible-width;height:row.height*1px;
                                Rectangle {height:parent.height - 6px;width:parent.width;background:#fff;border-radius:8px;border-width:1px;border-color:root.selected==i ? #a9c2e8 : #e3e7ed;}
                                if root.drag-from!=i || !root.dragging: VerticalBox {padding:8px;padding-left:40px;padding-right:12px;spacing:4px;alignment:start;
                                    HorizontalBox {padding:0;spacing:6px;height:28px;vertical-stretch:0;
                                        // 名称只使用操作列以外的空间；折叠时保留编辑按钮的位置，避免文本长度或展开状态改变列宽。
                                        RuleEntry {width:max(0px,parent.width - 174px);horizontal-stretch:0;enabled:!root.dialog-open;name:row.name;display-name:(row.expanded ? "▾ " : "▸ ")+row.name;chosen:root.selected==i;focus-generation:root.focus-generation;clicked=>{root.toggle-rule(row.identity);}}
                                        Rectangle {width:48px;horizontal-stretch:0;
                                            if row.expanded: Button {width:parent.width;height:parent.height;enabled:!root.dialog-open;text:"编辑";clicked=>{root.select-rule(i);}}
                                        }
                                        Button {enabled:!root.dialog-open;text:row.enabled ? "已启用" : "已禁用";primary:row.enabled;width:76px;horizontal-stretch:0;accessible-checkable:true;accessible-checked:row.enabled;clicked=>{root.inline-enabled(row.identity,!row.enabled);}}
                                        Button {enabled:!root.dialog-open;text:"···";accessible-label:"规则更多操作";width:32px;horizontal-stretch:0;clicked=>{root.choose-row(i);root.menu-row=root.menu-row==i ? -1 : i;}}
                                    }
                                    Text {text:(row.group=="" ? "未分组" : row.group)+" · "+row.source;color:#748092;font-size:12px;overflow:elide;vertical-stretch:0;}
                                    if row.expanded && root.section==1: Text {text:row.summary;color:#526172;vertical-stretch:0;}
                                    if row.expanded && root.section!=1: VerticalBox {padding:0;spacing:4px;vertical-stretch:0;
                                        for term[t] in row.terms: HorizontalBox {padding:0;spacing:4px;alignment:start;vertical-stretch:0;
                                            TermInput {width:min(EditorMetrics.control-width,parent.width - 36px);horizontal-stretch:0;enabled:!root.dialog-open;value:term;stage(value)=>{root.stage-term(row.identity,t,value);}commit(value)=>{root.inline-term(row.identity,t,value,false);}}
                                            Button {enabled:!root.dialog-open;text:"×";accessible-label:"删除匹配内容";width:32px;horizontal-stretch:0;clicked=>{root.inline-term(row.identity,t,"",true);}}
                                        }
                                        HorizontalBox {padding:0;spacing:4px;alignment:start;vertical-stretch:0;
                                            add-input := LineEdit {width:min(EditorMetrics.control-width,parent.width - 36px);horizontal-stretch:0;enabled:!root.dialog-open;placeholder-text:"添加匹配内容";min-height:32px;accepted=>{root.inline-term(row.identity,-1,self.text,false);self.text="";}}
                                            Button {enabled:!root.dialog-open;text:"＋";accessible-label:"添加匹配内容";width:32px;horizontal-stretch:0;clicked=>{root.inline-term(row.identity,-1,add-input.text,false);add-input.text="";}}
                                        }
                                    }
                                }
                                Text {x:8px;y:8px;width:24px;height:28px;text:"⠿";color:#8994a4;vertical-alignment:center;horizontal-alignment:center;}
                        // 手柄持续持有指针；只更新预览位置，不在手势中重建列表。
                        handle := TouchArea { x:6px; width:32px; height:parent.height; enabled:!root.dialog-open && (root.search=="");mouse-cursor:grab;
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    root.drag-from=i;root.drag-id=row.identity;root.dragging=false;root.grab-y=self.mouse-y;root.menu-row=-1;
                                    root.drag-y=row.offset*1px+self.mouse-y;root.drag-pointer-y=root.drag-y+list.viewport-y;
                                }
                                if event.kind == PointerEventKind.up && root.drag-from==i {
                                    if root.dragging && root.drop-target>=0 && root.drag-pointer-y>=0px && root.drag-pointer-y<=list.height && self.mouse-x+6px>=0px && self.mouse-x+6px<=list.width {root.drop-row(root.drag-id,root.drop-target,root.drop-after);}
                                    root.drag-from=-1;root.dragging=false;root.drop-target=-1;
                                }
                                if event.kind == PointerEventKind.cancel {root.drag-from=-1;root.dragging=false;}
                            }
                            moved => {if self.pressed && root.drag-from==i {
                                if abs(self.mouse-y - self.pressed-y)>8px {root.dragging=true;}
                                root.drag-y=row.offset*1px+self.mouse-y;root.drag-pointer-y=root.drag-y+list.viewport-y;
                                if root.dragging {root.drag-hover(root.drag-y/1px);}
                            }}
                        }
                    }

                        }
                        if root.rows.length==0: Text {text:root.search=="" ? "点击 ＋ 添加规则" : "没有找到匹配的规则";color:#687386;horizontal-alignment:center;vertical-alignment:center;}
                if root.dragging && root.drop-target>=0: Rectangle {
                    x:42px;width:parent.width - 60px;height:3px;background:#2468d8;
                    y: root.drop-line-y*1px + list.viewport-y;
                }
                if root.dragging: Rectangle {
                    x:48px;y:root.drag-pointer-y - root.grab-y;width: min(480px,parent.width - 70px);height:56px;
                    background:#e8f0ff;border-color:#8bafe9;border-width:1px;border-radius:8px;
                    Text{x:16px;width:parent.width - 32px;text:"⠿  " + root.rows[root.drag-from].name;vertical-alignment:center;overflow:elide;}
                }
                Timer {interval:16ms;running:root.dragging;
                    triggered => {
                        if root.drag-pointer-y<40px && list.viewport-y<0px {
                            list.viewport-y=min(0px,list.viewport-y+8px);root.drag-y=root.drag-pointer-y - list.viewport-y;root.drag-hover(root.drag-y/1px);
                        } else if root.drag-pointer-y>list.height - 40px && list.viewport-y > min(0px,list.height - list.viewport-height) {
                            list.viewport-y=max(min(0px,list.height - list.viewport-height),list.viewport-y - 8px);root.drag-y=root.drag-pointer-y - list.viewport-y;root.drag-hover(root.drag-y/1px);
                        }
                    }
                }

                        if root.menu-row>=0: Rectangle {x:parent.width - 164px;y:min(parent.height - self.height,max(0px,root.rows[root.menu-row].offset*1px+list.viewport-y+36px));width:160px;height:180px;background:#fff;border-radius:8px;border-width:1px;border-color:#cbd3df;
                            VerticalBox {padding:8px;spacing:4px;
                                Button {text:"编辑规则";clicked=>{root.select-rule(root.menu-row);root.menu-row=-1;}}
                                Button {text:"复制";clicked=>{root.copy-rule();root.menu-row=-1;}}
                                Button {text:"上移";enabled:root.search=="";clicked=>{root.move-rule(-1);root.menu-row=-1;}}
                                Button {text:"下移";enabled:root.search=="";clicked=>{root.move-rule(1);root.menu-row=-1;}}
                                Button {text:"删除";clicked=>{root.delete-rule();root.menu-row=-1;}}
                            }
                        }
                    }
                }
            }
            if root.section == 3: ScrollView {VerticalBox { padding:0;alignment:start;spacing:8px;
                    Text{vertical-stretch:0;text:"系统信息固定置顶，其他标签和字段按配置排列。";}
                    LineEdit{enabled:!root.dialog-open;text <=> root.title-text;placeholder-text:"报告标题";}
                    LineEdit{enabled:!root.dialog-open;text <=> root.system-title;placeholder-text:"系统信息标题";}
                    LineEdit{enabled:!root.dialog-open;text <=> root.keyword-title;placeholder-text:"关键词标题";}
                    LineEdit{enabled:!root.dialog-open;text <=> root.timeline-title;placeholder-text:"时间线标题";}
                    ComboBox{enabled:!root.dialog-open;model:["关键词 → 时间线","时间线 → 关键词","仅关键词","仅时间线"];current-index <=> root.section-order;}
                    HorizontalBox { padding:0;ComboBox{enabled:!root.dialog-open;model:["蓝色","绿色","紫色","灰色"];selected(value)=>{root.accent=value=="绿色"?"#16816a":value=="紫色"?"#7450c2":value=="灰色"?"#526172":"#2468d8";}}Text{vertical-stretch:0;text:"主题色";}LineEdit{enabled:!root.dialog-open;text <=> root.accent;}Text{vertical-stretch:0;text:"字号";}SpinBox{enabled:!root.dialog-open;value <=> root.font-size;minimum:10;maximum:24;}}
                    ComboBox{enabled:!root.dialog-open;model:["舒适间距","紧凑间距"];current-index <=> root.density;}
                    ComboBox{enabled:!root.dialog-open;model:["时间线从新到旧","时间线从旧到新"];current-index <=> root.timeline-sort;}
                    CheckBox{enabled:!root.dialog-open;text:"默认展开第一条有匹配的规则";checked <=> root.first-open;}
                    HorizontalBox { padding:0;vertical-stretch:0;Text{vertical-stretch:0;text:"日志每批显示";vertical-alignment:center;}SpinBox{enabled:!root.dialog-open;value <=> root.log-lines-per-batch;minimum:10;maximum:5000;}Text{vertical-stretch:0;text:"行";vertical-alignment:center;}}

            }}
            if !root.dialog-open && root.feedback != "": Text {text:root.feedback;wrap:word-wrap;color:#526172;vertical-stretch:0;}
            HorizontalBox { padding:0;height:32px;vertical-stretch:0;
                Text {text:root.dirty ? "有未保存的修改" : "修改后保存全部，取消可撤回本次编辑。";color:#687386;vertical-alignment:center;}
                Button{enabled:!root.dialog-open;horizontal-stretch:0;width:90px;text:"取消";clicked=>{root.cancel-edit();}}
                Button{enabled:!root.dialog-open;text:"还原默认规则";clicked=>{root.restore-defaults();}}
                Button{enabled:!root.dialog-open;horizontal-stretch:0;width:110px;text:"保存全部";primary:true;clicked=>{root.save-all();}}
            }
        }
    }
    // 常驻焦点容器保证每次打开弹窗都能立即接管键盘，关闭后归还列表。
    modal := FocusScope {
        visible: root.drawer-progress>0; enabled:root.dialog-open && !root.webdav-dialog-open;opacity:root.drawer-progress;width:parent.width;height:parent.height;
        key-pressed(event) => {if event.text==Key.Escape {root.cancel-dialog();return accept;}return reject;}
        Rectangle {width:parent.width;height:parent.height;background:#26324780;TouchArea{}}
        Rectangle {x:parent.width - self.width + (1-root.drawer-progress)*self.width;y:0px;width:root.width<1000px ? parent.width : 740px;height:parent.height;
            background:#fff;border-radius:0px;
            VerticalBox {padding:20px;spacing:12px;
                HorizontalBox { padding:0;height:32px;
                    Text{text:root.wizard ? (root.section==1 ? "添加系统信息规则" : root.section==2 ? "添加时间线规则" : "添加关键词规则") : "编辑规则";font-size:18px;font-weight:600;vertical-alignment:center;}
                    Button{text:"×";width:36px;horizontal-stretch:0;clicked=>{root.cancel-dialog();}}
                }
                Text {text:root.source;overflow:elide;color:#748092;font-size:12px;vertical-stretch:0;}
                if root.wizard: Text {text:root.step==0 ? "1 选择来源  ───  2 设置内容  ───  3 确认展示" : root.step==1 ? "来源已选择  ───  2 设置内容  ───  3 确认展示" : "来源已选择  ───  内容已设置  ───  3 确认展示";color:#2468d8;vertical-stretch:0;}
                form-scroll := ScrollView {viewport-height:max(self.visible-height,form.min-height); form := VerticalBox { padding:0;x:0px;y:0px; width:form-scroll.visible-width; height:self.min-height;alignment:start;vertical-stretch:0;spacing:12px;
                    if !root.wizard || root.step==0: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:10px;
                        if root.wizard: Text{text:"你想从哪些文件中提取内容？";font-size:16px;font-weight:600;vertical-stretch:0;}
                        Text{text:"基本信息";font-size:16px;font-weight:600;vertical-stretch:0;}
                        HorizontalBox {padding:0;vertical-stretch:0;height:32px;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"规则名称";}
                            LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.rule-name;placeholder-text:"例如：连接超时";}
                        }
                        HorizontalBox {padding:0;vertical-stretch:0;height:32px;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"状态";}
                            Button{text:root.enabled-rule ? "已启用" : "已禁用";primary:root.enabled-rule;width:76px;horizontal-stretch:0;accessible-checkable:true;accessible-checked:root.enabled-rule;clicked=>{root.enabled-rule=!root.enabled-rule;}}
                        }
                        if root.show-errors && root.rule-name=="":Text{text:"请填写规则名称";color:#a54432;vertical-stretch:0;}
                        HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"报告分组";}
                            Rectangle {width:root.field-width;height:EditorMetrics.control-height;horizontal-stretch:0;
                                LineEdit {x:0px;y:0px;width:parent.width - 36px;height:parent.height;text <=> root.group-name;placeholder-text:"输入或选择报告分组";}
                                Button {x:parent.width - 32px;width:32px;height:32px;text:"";accessible-label:"选择已有报告分组";clicked=>{group-menu.show();}}
                                    Path {x:parent.width - 21px;y:13px;width:10px;height:6px;stroke:#66758a;stroke-width:1.5px;commands:"M 0 0 L 5 5 L 10 0";}
                                group-menu := PopupWindow {x:0px;y:34px;width:parent.width;height:180px;
                                    Rectangle {background:#fff;border-width:1px;border-color:#dce2ea;border-radius:6px;
                                        ScrollView {width:parent.width;height:parent.height;
                                            VerticalBox {padding:6px;spacing:4px;alignment:start;
                                                for group in root.group-choices: Button {text:group=="" ? "未分组" : group;clicked=>{root.group-name=group;group-menu.close();}}
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Text{text:"日志来源";font-size:16px;font-weight:600;vertical-stretch:0;}
                        HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"文件范围";}
                            LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.source;placeholder-text:"日志文件；多个范围用分号隔开";}
                        }
                        HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"匹配方式";}
                            ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["文件名或相对路径开头","路径包含此内容","精确相对路径"];current-index <=> root.source-mode;}
                        }
                        if root.show-errors && root.source=="":Text{text:"请填写日志来源";color:#a54432;vertical-stretch:0;}
                        Text{text:root.source-mode==0 ? "可填 log/syslog 限定目录并包含轮转日志；只填文件名兼容旧规则。" : root.source-mode==1 ? "匹配路径包含这段内容的文件。" : "按诊断包内相对路径精确匹配，如 cmd/lsblk.log，无需填写诊断包顶层目录。";wrap:word-wrap;color:#748092;font-size:12px;vertical-stretch:0;}
                        if root.wizard: Button{vertical-stretch:0;min-height:32px;text:"加载样例文件（可选）";clicked=>{root.load-sample();}}
                    }
                    if (!root.wizard || root.step==1) && root.section!=1: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:10px;
                        Text{text:root.wizard ? "日志中出现什么内容时，需要提取？" : "匹配内容";font-size:16px;font-weight:600;vertical-stretch:0;}
                        HorizontalBox { padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"新增关键词";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.new-term;placeholder-text:"输入关键词后按回车";accepted=>{root.add-term();}}Button{vertical-stretch:0;min-height:32px;text:"＋";accessible-label:"添加匹配内容";width:32px;horizontal-stretch:0;clicked=>{root.add-term();}}}
                        if root.show-errors && root.term-tags.length==0 && root.new-term=="":Text{text:"请添加至少一个关键词";color:#a54432;vertical-stretch:0;}
                        for term[i] in root.term-tags: HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"关键词";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text:term;edited=>{root.edit-term(i,self.text);}}
                            Button {text:"×";accessible-label:"删除匹配内容";width:32px;horizontal-stretch:0;clicked=>{root.remove-term(i);}}
                        }
                        HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"匹配条件";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["包含任意关键词","包含全部关键词"];current-index <=> root.match-mode;}}
                        Text{text:root.match-mode==0 ? "日志中出现其中一个关键词，就视为匹配。" : "同一日志行包含全部关键词，才视为匹配。";color:#687386;vertical-stretch:0;wrap:word-wrap;}
                        if root.wizard: Text{text:"示例：关键词 timeout 可匹配 connection timeout after 30s。";wrap:word-wrap;color:#687386;vertical-stretch:0;}
                        Disclosure{text:"更多匹配选项";expanded:root.match-options;clicked=>{root.match-options=!root.match-options;}}
                        if root.match-options: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:8px;
                            HorizontalBox{ padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;CheckBox{text:"区分大小写";checked <=> root.case-sensitive;}CheckBox{text:"正则表达式";checked <=> root.regex-mode;}}
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"排除词";}TextEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;text <=> root.excludes;height:65px;}}
                        }
                    }
                    if (!root.wizard || root.step==1) && root.section==1: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:10px;
                        Text{text:"选择要提取的字段";font-size:16px;font-weight:600;vertical-stretch:0;}
                        Button{vertical-stretch:0;min-height:32px;text:"加载样例文件";clicked=>{root.load-sample();}}
                        Text{text:"加载 JSON 样例后，可从列表选择来源字段，再填写便于理解的显示名称。";wrap:word-wrap;color:#687386;vertical-stretch:0;}
                    if root.view-mode >= 2: Text{text:"存储展示使用 sysinfo 的磁盘结构；字段仍可在下方编辑。";wrap:word-wrap;}
                    HorizontalBox { padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"提取方式";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["JSON 字段","文本键值","重复段落","表格列","正则捕获"];current-index <=> root.extract-mode;}}HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"展示方式";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["卡片","表格","存储池与硬盘","每盘 SMART"];current-index <=> root.view-mode;}}
                    if root.extract-mode==0 || root.extract-mode==2: HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"提取路径";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.selector;placeholder-text:"数组路径或段落名称，如 disk.devices[] / Memory Device";}}
                    if root.extract-mode==4: HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"提取正则";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.extract-pattern;placeholder-text:"正则捕获表达式（仅正则提取使用）";}}
                    Text{vertical-stretch:0;text:"展示字段（顺序就是报告中的顺序）";font-weight:600;}
                    for field[i] in root.field-rows: VerticalBox {padding:0;alignment:start;vertical-stretch:0;spacing:8px;
                        Text{text:"字段 " + (i+1);font-weight:600;horizontal-alignment:left;vertical-stretch:0;}
                        HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"显示名称";}
                            LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> field.name;placeholder-text:"例如：设备型号";edited=>{root.edit-field(i,0,self.text);}}
                        }
                        HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"来源字段";}
                            LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> field.path;placeholder-text:"例如：model";edited=>{root.edit-field(i,1,self.text);}}
                        }
                        HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"显示格式";}
                            ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["原始文本","容量（字节）","时间戳（秒）","容量（KiB）"];current-index <=> field.format;selected(value)=>{root.edit-field(i,2,""+self.current-index);}}
                        }
                        HorizontalBox {padding:0;vertical-stretch:0;
                            spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"操作";}
                            Button{text:"详细设置";clicked=>{root.select-field(i);root.field-options=true;}}
                            Button{text:"删除";clicked=>{root.delete-field(i);}}
                        }
                        if root.show-errors && (field.name=="" || field.path==""):Text{text:"请填写字段的显示名称和来源字段";color:#a54432;vertical-stretch:0;}
                        if root.sample-paths.length>0: HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"样例字段";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:root.sample-paths;selected(value)=>{root.edit-field(i,1,value);}}}
                    }
                    Button{vertical-stretch:0;min-height:32px;text:"＋ 添加字段";clicked=>{root.new-field();}}
                    Disclosure{text:"字段详细设置与排序";expanded:root.field-options;clicked=>{root.field-options=!root.field-options;}}
                    if root.field-options: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:8px;
                        HorizontalBox{ padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"选择字段";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:root.field-names;current-index <=> root.field-index;selected(_)=>{root.select-field(self.current-index);}}Button{vertical-stretch:0;min-height:32px;text:"删除字段";enabled:root.field-index>=0;clicked=>{root.delete-field(root.field-index);}}}
                        HorizontalBox{ padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;Button{vertical-stretch:0;min-height:32px;text:"字段上移";clicked=>{root.move-field(-1);}}Button{vertical-stretch:0;min-height:32px;text:"字段下移";clicked=>{root.move-field(1);}}}
                        HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"单位";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.field-unit;placeholder-text:"单位，可留空";}}
                        HorizontalBox{ padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"缺失提示";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.field-missing;placeholder-text:"字段缺失提示，留空不显示";}CheckBox{text:"卡片占整行";checked <=> root.field-wide;}}
                        HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"字段展示";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["沿用组展示","卡片","表格列"];current-index <=> root.field-view;}}
                        HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"二次提取";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.field-capture;placeholder-text:"字段内二次提取正则（第一捕获组），可留空";}}
                    }
                    HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"缺失提示";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.missing;placeholder-text:"未提取到内容时的提示，留空则隐藏";}}
                    Disclosure{text:"跨来源关联（高级）";expanded:root.advanced;clicked=>{root.advanced=!root.advanced;}}
                    if root.advanced: VerticalBox { padding:0;alignment:start;vertical-stretch:0;HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"关联规则";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.join-rule;placeholder-text:"关联信息组 ID";}}HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"本组关联列";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.join-key;placeholder-text:"本组关联列的中文名称";}}HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"对方关联列";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.foreign-key;placeholder-text:"对方关联列的中文名称";}}}

                    }
                    if !root.wizard: Disclosure{text:"报告展示";expanded:root.display-options;clicked=>{root.display-options=!root.display-options;}}
                    if (root.wizard && root.step==2) || (!root.wizard && root.display-options): VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:10px;
                        if root.wizard: Text{text:"确认这条规则";font-size:16px;font-weight:600;vertical-stretch:0;}
                        if root.wizard: Text{text:root.rule-name + " · " + root.group-name;wrap:word-wrap;font-weight:600;vertical-stretch:0;}
                        if root.wizard: Text{text:root.section==1 ? "从 " + root.source + " 提取 " + root.field-names.length + " 个字段。" : "从 " + root.source + " 查找：" + root.terms;wrap:word-wrap;color:#526172;vertical-stretch:0;}
                        if root.section!=1: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:10px;
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"展示位置";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["仅关键词线索","仅时间线","两处展示"];current-index <=> root.target;}}
                            HorizontalBox{padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"上下文";}Text{text:"前";vertical-alignment:center;horizontal-stretch:0;}SpinBox{value <=> root.before;minimum:0;maximum:100000;}Text{text:"行 / 后";vertical-alignment:center;horizontal-stretch:0;}SpinBox{value <=> root.after;minimum:0;maximum:100000;}Text{text:"行";vertical-alignment:center;horizontal-stretch:0;}}
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"日志排序";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["来源顺序","时间升序","时间降序"];current-index <=> root.sort-mode;}}
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"参考说明";}TextEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;text <=> root.note;height:65px;}}
                        }
                        if root.section==1: HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"展示方式";}ComboBox{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;model:["卡片","表格","存储池与硬盘","每盘 SMART"];current-index <=> root.view-mode;}}
                    }
                    if !root.wizard || root.step>0: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:10px;
                        if root.section!=1: Disclosure{text:"高级设置";expanded:root.advanced;clicked=>{root.advanced=!root.advanced;}}
                        if root.section!=1 && root.advanced: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:8px;
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"时间正则";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.time-pattern;placeholder-text:"时间正则：捕获组命名为 time；留空自动识别";}}
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"时间格式";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.time-format;placeholder-text:"时间格式，例如 %Y-%m-%d %H:%M:%S";}}
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"时区";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.timezone;placeholder-text:"时区，例如 +08:00；未知留空";}}
                            HorizontalBox{ padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;CheckBox{text:"从文件末尾查找";checked <=> root.reverse;}CheckBox{text:"默认展开";checked <=> root.rule-open;}}
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"格式化器";}LineEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;height:EditorMetrics.control-height;text <=> root.formatter;placeholder-text:"格式化器，例如 volume_info";}}
                        }
                        Disclosure{text:"用样例测试";expanded:root.test-options;clicked=>{root.test-options=!root.test-options;}}
                        if root.test-options: VerticalBox { padding:0;alignment:start;vertical-stretch:0;spacing:8px;
                            HorizontalBox{ padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;Button{vertical-stretch:0;min-height:32px;text:"加载样例日志";clicked=>{root.load-sample();}}Button{vertical-stretch:0;min-height:32px;text:"预览效果";clicked=>{root.test-rule();}}}
                            HorizontalBox {padding:0;vertical-stretch:0;spacing:EditorMetrics.field-gap;alignment:start;FormLabel{text:"样例日志";}TextEdit{width:root.field-width;horizontal-stretch:0;vertical-stretch:0;text <=> root.sample;height:100px;}}
                            Text{text:"预览不会保存规则，未加载样例也可以完成添加。";color:#687386;vertical-stretch:0;wrap:word-wrap;}
                        }
                    }
                }}
                if root.feedback != "": Text{text:root.feedback;wrap:word-wrap;color:#a54432;vertical-stretch:0;}
                HorizontalBox { padding:0;height:36px;
                    Text{text:"完成后加入草稿，保存全部后生效。";color:#748092;font-size:12px;vertical-alignment:center;}
                    Button{horizontal-stretch:0;width:72px;text:"取消";clicked=>{root.cancel-dialog();}}
                    if root.wizard && root.step>0: Button{horizontal-stretch:0;width:72px;text:"上一步";clicked=>{root.step -= 1;root.feedback="";}}
                    Button{horizontal-stretch:0;width:94px;text:root.wizard && root.step<2 ? "下一步" : root.wizard ? "完成添加" : "完成";primary:true;clicked=>{if root.wizard && root.step<2 {root.next-step();}else{root.apply-rule();}}}
                }
            }
        }
    }
    // 专用模态层不共用规则表单与反馈；遮罩阻止穿透，焦点停留在配置任务内。
    webdav-modal := FocusScope {
        visible: root.webdav-dialog-open; enabled: root.webdav-dialog-open;
        width: parent.width; height: parent.height;
        key-pressed(event) => {if event.text==Key.Escape {root.webdav-cancel();return accept;}return reject;}
        Rectangle {width:parent.width;height:parent.height;background:#26324780;TouchArea{}}
        Rectangle {
            x:(parent.width - self.width)/2; y:(parent.height - self.height)/2;
            width:min(520px,parent.width - 32px); height:min(500px,parent.height - 32px);
            background:#fff; border-radius:14px; border-width:1px; border-color:#dce2ea;
            VerticalBox {padding:16px;spacing:8px;
                HorizontalBox { padding:0;height:36px;
                    Text{text:root.webdav-configured ? "编辑 WebDAV 服务器" : "添加 WebDAV 服务器";font-size:18px;font-weight:600;vertical-alignment:center;}
                    Button{text:"×";accessible-label:"关闭 WebDAV 设置";width:36px;horizontal-stretch:0;clicked=>{root.webdav-cancel();}}
                }
                ScrollView {VerticalBox { padding:0;spacing:8px;
                    Text{text:"服务器地址";vertical-stretch:0;}
                    webdav-address := LineEdit{enabled:!root.webdav-testing;text <=> root.webdav-url;placeholder-text:"https://example.com/dav/";min-height:36px;vertical-stretch:0;}
                    Text{text:"远端文件路径";vertical-stretch:0;}
                    LineEdit{enabled:!root.webdav-testing;text <=> root.webdav-path;placeholder-text:"rules.json";min-height:36px;vertical-stretch:0;}
                    Text{text:"用户名";vertical-stretch:0;}
                    LineEdit{enabled:!root.webdav-testing;text <=> root.webdav-user;placeholder-text:"未启用认证时可留空";min-height:36px;vertical-stretch:0;}
                    Text{text:"密码";vertical-stretch:0;}
                    LineEdit{enabled:!root.webdav-testing;input-type:password;text <=> root.webdav-password;placeholder-text:root.webdav-configured ? "留空沿用已保存的密码" : "服务器密码";min-height:36px;vertical-stretch:0;}
                    Text{text:"测试连接不会保存配置。";color:#687386;font-size:12px;vertical-stretch:0;}
                    Text{text:root.webdav-feedback;wrap:word-wrap;color:#526172;vertical-stretch:0;}
                }}
                HorizontalBox { padding:0;height:32px;vertical-stretch:0;
                    Button{text:root.webdav-testing ? "正在连接…" : "测试连接";enabled:!root.webdav-testing;clicked=>{root.webdav-test-dialog();}}
                    Rectangle{horizontal-stretch:1;}
                    Button{text:"取消";clicked=>{root.webdav-cancel();}}
                    Button{text:"保存";primary:true;enabled:!root.webdav-testing;clicked=>{root.webdav-save();}}
                }
            }
        }
    }
}
export component ImportWindow inherits Window {
    title: "TraceFox · 导入预览"; icon: @image-url("../assets/branding/tracefox-app.png"); preferred-width: 560px; preferred-height: 420px; min-width: 520px; min-height: 360px;
    in property <string> summary;
    in-out property <bool> replace-existing: false;
    in property <bool> reference-only: false;
    callback confirm(bool); callback cancel-import();
    VerticalBox {padding:14px;spacing:8px;
        Text{text:"确认要导入的规则";font-size:20px;font-weight:600;vertical-stretch:0;}
        ScrollView {VerticalBox {padding:0;alignment:start;Text{text:root.summary;wrap:word-wrap;vertical-stretch:0;}}}
        if !root.reference-only: CheckBox{text:"替换同名规则和报告布局（不勾选则保留现有）";checked <=> root.replace-existing;}
        HorizontalBox { padding:0;height:32px;vertical-stretch:0;alignment:end;Button{text:"取消";clicked=>{root.cancel-import();}}Button{text:"导入到草稿";primary:true;clicked=>{root.confirm(root.replace-existing);}}}
    }
}
